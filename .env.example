# Copy to .env.local and fill in. Never commit real values.
# Variable names only; services are added as the build plan reaches them.

# --- Database (local Supabase: `pnpm db:start`, values from `pnpm db:status`) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Creates staff sign-in accounts (step 2.7) and stores pictures (step 2.5).
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption of access codes (step 1.6) ---
# KMS_KEY_ID: AWS KMS key id or alias (production).
# LOCAL_KMS_MASTER_KEY: 32 random bytes as base64 (development),
# for example from `openssl rand -base64 32`.
KMS_KEY_ID=
LOCAL_KMS_MASTER_KEY=

# --- Claude (steps 3.2, 5.5, 6.x) ---
# Free-text sms replies are read by Claude Sonnet 5.5 (step 3.2). Empty: they all go to staff.
ANTHROPIC_API_KEY=

# --- 46elks SMS and voice (steps 3.x, 6.x) ---
# Empty: a fake that writes each sms to the console (development only).
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
# Default sender: a number or at most 11 letters. Default "Bojen".
ELKS_FROM=
# The token in the delivery-report URL (`APP_URL/api/webhooks/elks/delivery?token=…`).
# At least 32 random characters.
ELKS_WEBHOOK_SECRET=
# Comma-separated addresses allowed to call the 46elks webhooks. Empty: 46elks' published
# addresses in production, no check in development (step 3.2).
ELKS_ALLOWED_IPS=
# 1: 46elks checks each request but sends nothing and charges nothing.
ELKS_DRY_RUN=
# The public address of the web app, for webhook URLs and the customer's short links
# (`bojen.app/x/{code}`, step 3.4), for example https://bojen.app.
APP_URL=

# --- Short links (step 3.4) ---
# The codes in the customer's links are stored as HMAC hashes with this key; the web app and
# the worker need the same one. At least 32 random characters, for example from
# `openssl rand -base64 32`. Changing it breaks every link already sent.
SHORT_LINK_KEY=

# --- STOPP list (step 3.1) ---
# Opted-out numbers are stored as HMAC hashes with this key. At least 32 random characters,
# for example from `openssl rand -base64 32`. Never change it: the list would be lost.
SMS_OPT_OUT_KEY=

# --- Staff sign-in by sms (step 3.1) ---
# Supabase Auth's send_sms hook secret, `v1,whsec_<base64>`. Locally the same value goes in
# supabase/.env together with SUPABASE_AUTH_SMS_HOOK_URI (read by `supabase start`), e.g.
#   SUPABASE_AUTH_SMS_HOOK_URI=http://host.docker.internal:3100/api/webhooks/supabase/send-sms
# The hook reaches the app on port 3100 (`next start -p 3100`, as the end-to-end tests do).
SUPABASE_AUTH_SMS_HOOK_SECRET=

# --- E-mail: our own mail server (step 3.1; docs/egen-drift.md) ---
# Submission with implicit TLS on 465. Empty SMTP_HOST: a fake that writes each e-mail to the
# console (development only).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# For example "Bojen <noreply@bojen.app>". Default: Bojen <SMTP_USER>.
MAIL_FROM=

# --- AWS keys for KMS (production) ---
# An IAM user that may only use the KMS key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1

# --- Travel times: OSRM on OpenStreetMap (step 2.2) ---
# Base URL of an own OSRM server with the Sweden extract, for example http://localhost:5000.
# Not needed for tests, which use the fake maps adapter.
OSRM_URL=

# --- Public booking page (step 2.5) ---
# Address search with Photon (OpenStreetMap), for example https://photon.komoot.io.
# Empty: a fake with a few made-up addresses (development and tests).
PHOTON_URL=
# Signs the customer's session after the sms code. At least 32 random characters,
# for example from `openssl rand -base64 32`. Required in production.
BOOKING_SESSION_SECRET=

# --- Azure Speech, Sweden Central (step 6.2) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral

# --- LiveKit (step 6.2) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Fortnox (step 8) ---
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=

# The receptionist's tool API (step 6.1). VOICE_TOOLS_SECRET signs each call's short-lived
# token and the times offered in it; VOICE_SERVICE_SECRET is what the voice agent (step 6.2)
# sends to start a call. At least 32 characters each, different from each other.
VOICE_TOOLS_SECRET=
VOICE_SERVICE_SECRET=

# Reaching a person (step 6.4). The firm's 46elks number has voice_start set to
# {APP_URL}/api/webhooks/elks/samtal?token={ELKS_WEBHOOK_SECRET}. Before each call the web app
# asks the voice agent's health check; if it does not answer, the call goes straight to the
# mechanic's mobile (K10). Without VOICE_AGENT_SIP every call goes to the mechanic.
VOICE_AGENT_SIP=
VOICE_AGENT_HEALTH_URL=
# The agent process's own health check port (default 8081).
VOICE_HEALTH_PORT=

# Web push to staff (step 6.4). Make the keys once with `npx web-push generate-vapid-keys`;
# VAPID_SUBJECT is mailto: or the app's address. Without them development logs the push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Error reports to GlitchTip (step 9). Without it nothing is sent; errors are still logged.
# APP_RELEASE is the deployed commit and is set by infra/scripts/deploy.sh.
GLITCHTIP_DSN=
APP_RELEASE=

# Fortnox (step 8): the app in Fortnox developer portal. Without them the connection is off.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
