# Copy to .env.local and fill in. Never commit real values.
# Variable names only; services are added as the build plan reaches them.

# --- Database (local Supabase: `pnpm db:start`, values from `pnpm db:status`) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Creates staff sign-in accounts (step 2.7) and stores pictures (step 2.5).
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption of access codes (step 1.6) ---
# KMS_KEY_ID: AWS KMS key id or alias (production).
# LOCAL_KMS_MASTER_KEY: 32 random bytes as base64 (development),
# for example from `openssl rand -base64 32`.
KMS_KEY_ID=
LOCAL_KMS_MASTER_KEY=

# --- Claude (steps 3.2, 5.5, 6.x) ---
ANTHROPIC_API_KEY=

# --- 46elks SMS and voice (steps 3.x, 6.x) ---
# Empty: a fake that writes each sms to the console (development only).
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
# Default sender: a number or at most 11 letters. Default "Bojen".
ELKS_FROM=
# The token in the delivery-report URL (`APP_URL/api/webhooks/elks/delivery?token=…`).
# At least 32 random characters.
ELKS_WEBHOOK_SECRET=
# 1: 46elks checks each request but sends nothing and charges nothing.
ELKS_DRY_RUN=
# The public address of the web app, for webhook URLs, for example https://app.bojen.se.
APP_URL=

# --- STOPP list (step 3.1) ---
# Opted-out numbers are stored as HMAC hashes with this key. At least 32 random characters,
# for example from `openssl rand -base64 32`. Never change it: the list would be lost.
SMS_OPT_OUT_KEY=

# --- Staff sign-in by sms (step 3.1) ---
# Supabase Auth's send_sms hook secret, `v1,whsec_<base64>`. Locally the same value goes in
# supabase/.env together with SUPABASE_AUTH_SMS_HOOK_URI (read by `supabase start`), e.g.
#   SUPABASE_AUTH_SMS_HOOK_URI=http://host.docker.internal:3100/api/webhooks/supabase/send-sms
# The hook reaches the app on port 3100 (`next start -p 3100`, as the end-to-end tests do).
SUPABASE_AUTH_SMS_HOOK_SECRET=

# --- Mailgun EU (step 3.1) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# --- Travel times: OSRM on OpenStreetMap (step 2.2) ---
# Base URL of an own OSRM server with the Sweden extract, for example http://localhost:5000.
# Not needed for tests, which use the fake maps adapter.
OSRM_URL=

# --- Public booking page (step 2.5) ---
# Address search with Photon (OpenStreetMap), for example https://photon.komoot.io.
# Empty: a fake with a few made-up addresses (development and tests).
PHOTON_URL=
# Signs the customer's session after the sms code. At least 32 random characters,
# for example from `openssl rand -base64 32`. Required in production.
BOOKING_SESSION_SECRET=

# --- Azure Speech, Sweden Central (step 6.2) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral

# --- LiveKit (step 6.2) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Fortnox (step 8) ---
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
