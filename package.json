{
  "name": "bojen",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,realtime,supavisor,mailpit,storage-api,postgres-meta",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migrate": "pnpm --filter @bojen/db migrate",
    "db:generate": "pnpm --filter @bojen/db generate",
    "db:seed": "pnpm --filter @bojen/db seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.29",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
