# The server's environment (byggplan step 9). Copy to infra/.env on the server, never commit
# it, and keep a copy somewhere safe. Fill in by hand what is below, then add the generated
# secrets with `node infra/scripts/make-secrets.mjs >> infra/.env`.

# --- Domains (DNS A and AAAA records to the server) ---
APP_DOMAIN=bojen.se
API_DOMAIN=api.bojen.se
GLITCHTIP_DOMAIN=fel.bojen.se
ACME_EMAIL=
APP_URL=https://bojen.se

# --- Backups: Hetzner Object Storage, in another town than the server (spec 10.7) ---
# For example the bucket bojen-backup in Falkenstein: endpoint https://fsn1.your-objectstorage.com
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_REGION=fsn1
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# --- E-mail: Amazon SES in eu-north-1 ---
# The app sends through the SES API with the AWS keys below; Auth and GlitchTip through SES's
# SMTP interface with SMTP credentials made in the SES console. The password URL-encoded too.
SES_FROM=Bojen <noreply@bojen.se>
SES_REGION=eu-north-1
MAIL_FROM_ADDRESS=noreply@bojen.se
SES_SMTP_USER=
SES_SMTP_PASSWORD=
SES_SMTP_PASSWORD_URLENCODED=

# --- AWS: KMS and SES (an IAM user that may only use the key and send mail) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
KMS_KEY_ID=

# --- The services the app uses (as in the root .env.example) ---
ANTHROPIC_API_KEY=
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
ELKS_FROM=Bojen
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
# Web push: `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dataskydd@bojen.se

# --- Voice (from step 6.2b, with PROFILES="--profile voice" for deploy.sh) ---
VOICE_AGENT_SIP=
VOICE_AGENT_HEALTH_URL=

# --- Generated by infra/scripts/make-secrets.mjs (appended below) ---
